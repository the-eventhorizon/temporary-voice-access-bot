APP_ENV=local
DISCORD_TOKEN=replace-with-bot-token
DISCORD_APPLICATION_ID=replace-with-application-id
DISCORD_DEFAULT_GUILD_ID=
DATABASE_PATH=./data/access-bot.sqlite
INITIAL_JOIN_TIMEOUT_SECONDS=90
DEPARTURE_GRACE_PERIOD_SECONDS=90
REQUEST_EXPIRATION_SECONDS=300
LOG_LEVEL=info
WEB_ADMIN_HOST=127.0.0.1
WEB_ADMIN_PORT=8787
WEB_ADMIN_AUTH_HEADER=X-Website-Admin
WEB_ADMIN_AUTH_SECRET=